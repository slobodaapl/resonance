<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>ReferenceExtractor</AssemblyName>
    <RootNamespace>Resonance.ReferenceExtractor</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Tts/QwenNative.cs" Link="QwenNative.cs" />
    <Compile Include="../../src/Tts/WindowsNativeLibrary.cs" Link="WindowsNativeLibrary.cs" />
    <Compile Include="../../src/Bootstrap/ReferenceExtractionProtocol.cs" Link="ReferenceExtractionProtocol.cs" />
    <Compile Include="../../src/Bootstrap/BaseHostTransport.cs" Link="BaseHostTransport.cs" />
  </ItemGroup>
</Project>
