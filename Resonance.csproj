<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.4.0.0</Version>
    <AssemblyName>Resonance</AssemblyName>
    <RootNamespace>Resonance</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="VGAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resonance.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tools\ReferenceExtractor\**\*.cs" />
    <Compile Remove="tools\OfficialProfilePackBuilder\**\*.cs" />
    <Compile Remove="tools\VoiceReferencePilot\**\*.cs" />
    <Compile Remove="tools\CutscenePlanBuilder\**\*.cs" />
    <Compile Remove="tools\FallbackProfileGenerator\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove=".references\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <ReferenceExtractorProject>$(MSBuildProjectDirectory)\tools\ReferenceExtractor\ReferenceExtractor.csproj</ReferenceExtractorProject>
    <ReferenceExtractorBuildDirectory>$(MSBuildProjectDirectory)\tools\ReferenceExtractor\bin\$(Configuration)\net10.0\win-x64</ReferenceExtractorBuildDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ReferenceExtractorProject)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      CopyToOutputDirectory="Never"
                      CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="BuildReferenceExtractor" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ReferenceExtractorOutputDirectory>$(TargetDir)reference-extractor</ReferenceExtractorOutputDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(ReferenceExtractorOutputDirectory)" />
    <MakeDir Directories="$(ReferenceExtractorOutputDirectory)" />
    <ItemGroup>
      <ReferenceExtractorBuildFiles Include="$(ReferenceExtractorBuildDirectory)\**\*"
          Exclude="$(ReferenceExtractorBuildDirectory)\**\ggml*.dll;$(ReferenceExtractorBuildDirectory)\**\qwen*.dll;$(ReferenceExtractorBuildDirectory)\**\*.so;$(ReferenceExtractorBuildDirectory)\**\*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(ReferenceExtractorBuildFiles)"
          DestinationFiles="@(ReferenceExtractorBuildFiles->'$(ReferenceExtractorOutputDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishReferenceExtractor" AfterTargets="Publish">
    <PropertyGroup>
      <ReferenceExtractorPublishDirectory>$(PublishDir)reference-extractor</ReferenceExtractorPublishDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(ReferenceExtractorPublishDirectory)" />
    <MakeDir Directories="$(ReferenceExtractorPublishDirectory)" />
    <ItemGroup>
      <ReferenceExtractorPublishFiles Include="$(ReferenceExtractorBuildDirectory)\**\*"
          Exclude="$(ReferenceExtractorBuildDirectory)\**\ggml*.dll;$(ReferenceExtractorBuildDirectory)\**\qwen*.dll;$(ReferenceExtractorBuildDirectory)\**\*.so;$(ReferenceExtractorBuildDirectory)\**\*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(ReferenceExtractorPublishFiles)"
          DestinationFiles="@(ReferenceExtractorPublishFiles->'$(ReferenceExtractorPublishDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(PublishDir)ReferenceExtractor.exe;$(PublishDir)ReferenceExtractor.dll;$(PublishDir)ReferenceExtractor.pdb;$(PublishDir)ReferenceExtractor.deps.json;$(PublishDir)ReferenceExtractor.runtimeconfig.json" />
  </Target>
</Project>
