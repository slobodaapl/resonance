+void qt_get_abi_info(struct qt_abi_info * out) {
+    if (!out) {
+        return;
+    }
+    out->abi_version     = QT_ABI_VERSION;
+    out->abi_min_version = QT_ABI_MIN_VERSION;
+    out->init_params_size = (uint32_t) sizeof(struct qt_init_params);
+    out->tts_params_size  = (uint32_t) sizeof(struct qt_tts_params);
+    out->audio_size       = (uint32_t) sizeof(struct qt_audio);
+    out->voice_ref_size   = (uint32_t) sizeof(struct qt_voice_ref);
+}
+
+static enum qt_backend_type qt_classify_backend(ggml_backend_dev_t dev) {
+    const char * name = ggml_backend_dev_name(dev);
+    if (name && strncmp(name, "CUDA", 4) == 0) {
+        return QT_BACKEND_CUDA;
+    }
+    if (name && strncmp(name, "Vulkan", 6) == 0) {
+        return QT_BACKEND_VULKAN;
+    }
+    switch (ggml_backend_dev_type(dev)) {
+        case GGML_BACKEND_DEVICE_TYPE_CPU: return QT_BACKEND_CPU;
+        case GGML_BACKEND_DEVICE_TYPE_GPU: return QT_BACKEND_GPU;
+        case GGML_BACKEND_DEVICE_TYPE_ACCEL: return QT_BACKEND_ACCEL;
+        default: return QT_BACKEND_UNKNOWN;
+    }
+}
+
+int qt_backend_count(void) {
+    backend_load_all();
+    return (int) ggml_backend_dev_count();
+}
+
+enum qt_status qt_backend_load_from_path(const char * path) {
+    if (!path || !path[0]) {
+        qt_set_error("qt_backend_load_from_path: path is empty");
+        return QT_STATUS_INVALID_PARAMS;
+    }
+    backend_load_from_path(path);
+    return QT_STATUS_OK;
+}
+
+enum qt_status qt_backend_get_info(int index, struct qt_backend_info * out) {
+    backend_load_all();
+    if (!out || index < 0 || (size_t) index >= ggml_backend_dev_count()) {
+        qt_set_error("qt_backend_get_info: invalid index or output pointer");
+        return QT_STATUS_INVALID_PARAMS;
+    }
+    ggml_backend_dev_t dev = ggml_backend_dev_get((size_t) index);
+    size_t free_bytes = 0;
+    size_t total_bytes = 0;
+    ggml_backend_dev_memory(dev, &free_bytes, &total_bytes);
+    out->name         = ggml_backend_dev_name(dev);
+    out->description  = ggml_backend_dev_description(dev);
+    out->type         = qt_classify_backend(dev);
+    out->device_index = index;
+    out->memory_free  = (uint64_t) free_bytes;
+    out->memory_total = (uint64_t) total_bytes;
+    return QT_STATUS_OK;
+}
