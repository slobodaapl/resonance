+
+static __global__ void rms_norm_quantize_q8_1(const float * x, const float * gain,
+                                           block_q8_1 * out, int ncols, float eps) {
+    ggml_cuda_pdl_lc();
+    const int tid = threadIdx.x;
+    float sum = 0.0f;
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += 1024) {
+        const float xi = x[col];
+        sum += xi * xi;
+    }
+    extern __shared__ float partial[];
+    sum = block_reduce<block_reduce_method::SUM, 1024>(sum, partial);
+    const float scale = rsqrtf(sum / ncols + eps);
+    for (int col = tid; col < ncols; col += 1024) {
+        const float value = scale * x[col] * gain[col];
+        const float amax = warp_reduce_max<QK8_1>(fabsf(value));
+        const float total = warp_reduce_sum<QK8_1>(value);
+        const float d = amax / 127.0f;
+        const int block = col / QK8_1;
+        const int lane = col % QK8_1;
+        out[block].qs[lane] = amax == 0.0f ? 0 : roundf(value / d);
+        if (lane == 0) out[block].ds = make_half2(d, total);
+    }
+}
+
+
+void quantize_rms_norm_q8_1_cuda(const float * x, const float * gain, void * output,
+                                int ncols, float eps, cudaStream_t stream) {
+    GGML_ASSERT(ncols == 1024 || ncols == 2048);
+    const auto launch = ggml_cuda_kernel_launch_params(dim3(1), dim3(1024), 32 * sizeof(float), stream);
