+static int ggml_cuda_try_fuse_rms_norm_quantize(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * graph, int i) {
+    if (i + 2 >= graph->n_nodes) return 0;
+    const ggml_tensor * norm = graph->nodes[i];
+    const ggml_tensor * mul = graph->nodes[i + 1];
+    if (norm->op != GGML_OP_RMS_NORM || mul->op != GGML_OP_MUL) return 0;
+    const ggml_tensor * raw = norm->src[0];
+    const ggml_tensor * gain = mul->src[0] == norm ? mul->src[1] : mul->src[1] == norm ? mul->src[0] : nullptr;
+    if (!gain || raw->type != GGML_TYPE_F32 || gain->type != GGML_TYPE_F32 ||
+        norm->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(raw) || !ggml_is_contiguous(gain) || ggml_nrows(raw) != 1 ||
+        (raw->ne[0] != 1024 && raw->ne[0] != 2048) || ggml_nelements(gain) != raw->ne[0]) return 0;
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(eps));
+    for (int n_ops : {5, 3}) {
+        const ggml_op ops[] = {GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU};
+        const int output = i + n_ops - 1;
+        if (output >= graph->n_nodes || !ggml_can_fuse_subgraph(graph, i, n_ops, ops, &output, 1) ||
+            !ggml_cuda_check_fusion_memory_ranges(graph, i, n_ops, &output, 1)) continue;
+        ggml_tensor * first = graph->nodes[i + 2];
+        ggml_tensor * mm = n_ops == 5 ? graph->nodes[i + 3] : first;
+        if (mm->src[1] != mul || !ggml_cuda_should_fuse_mul_mat_vec_q(mm) ||
+            (mm->src[0]->type != GGML_TYPE_Q8_0 && mm->src[0]->type != GGML_TYPE_Q4_K) ||
+            mm->src[0]->ne[2] != 1 || mm->src[0]->ne[3] != 1) continue;
+        ggml_cuda_mm_fusion_args_host fusion{};
+        if (n_ops == 5) {
+            const ggml_tensor * glu = graph->nodes[output];
+            if (!ggml_cuda_should_fuse_mul_mat(mm, first, glu)) continue;
+            fusion.gate = first->src[0];
+            fusion.glu_op = ggml_get_glu_op(glu);
+        }
+        ggml_cuda_mul_mat_vec_q_rms_norm(*cuda_ctx, mm->src[0], raw, gain, eps,
+                                         graph->nodes[output], n_ops == 5 ? &fusion : nullptr);
+        return n_ops - 1;
+    }
+    return 0;
+}
