new file mode 100644
--- /dev/null
+++ b/src/attention-forward.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "talker-weights.h"
+
+static void attention_project(struct ggml_context * ctx, const TalkerAttention & attn,
+                              struct ggml_tensor * h, struct ggml_tensor ** q,
+                              struct ggml_tensor ** k, struct ggml_tensor ** v) {
+    if (h->ne[1] == 1 && attn.qkv_proj_w) {
+        struct ggml_tensor * all = ggml_mul_mat(ctx, attn.qkv_proj_w, h);
+        const int64_t nq = attn.q_proj_w->ne[1], nk = attn.k_proj_w->ne[1], nv = attn.v_proj_w->ne[1];
+        *q = ggml_view_1d(ctx, all, nq, 0);
+        *k = ggml_view_1d(ctx, all, nk, nq * sizeof(float));
+        *v = ggml_view_1d(ctx, all, nv, (nq + nk) * sizeof(float));
+    } else {
+        *q = ggml_mul_mat(ctx, attn.q_proj_w, h);
+        *k = ggml_mul_mat(ctx, attn.k_proj_w, h);
+        *v = ggml_mul_mat(ctx, attn.v_proj_w, h);
+    }
+}
+
+
+static void attention_qk_norm(struct ggml_context * ctx, const TalkerAttention & attn,
+                           struct ggml_tensor ** q, struct ggml_tensor ** k, float eps) {
+    if (attn.qk_norm_w && (*q)->ne[2] == 1 && (*q)->view_src && (*q)->view_src == (*k)->view_src) {
+        const int64_t hd = (*q)->ne[0], nq = (*q)->ne[1], nk = (*k)->ne[1];
+        GGML_ASSERT((*q)->view_offs == 0 && (*k)->view_offs == hd * nq * sizeof(float));
+        struct ggml_tensor * qk = ggml_view_3d(ctx, (*q)->view_src, hd, nq + nk, 1,
+                                             hd * sizeof(float), hd * (nq + nk) * sizeof(float), 0);
+        qk = ggml_mul(ctx, ggml_rms_norm(ctx, qk, eps), attn.qk_norm_w);
+        *q = ggml_view_3d(ctx, qk, hd, nq, 1, hd * sizeof(float), hd * nq * sizeof(float), 0);
+        *k = ggml_view_3d(ctx, qk, hd, nk, 1, hd * sizeof(float), hd * nk * sizeof(float), hd * nq * sizeof(float));
+    } else {
+        *q = ggml_mul(ctx, ggml_rms_norm(ctx, *q, eps), attn.q_norm_w);
+        *k = ggml_mul(ctx, ggml_rms_norm(ctx, *k, eps), attn.k_norm_w);
+    }
+}
