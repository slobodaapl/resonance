+        ctx->prealloc_size_y = size;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    if (ctx->prealloc_y_need_sync) ggml_vk_sync_buffers(ctx, subctx);
+    struct {
+        uint32_t ne, a_offset, b_offset;
+        float eps;
+    } pc;
+    pc.ne = (uint32_t) raw->ne[0];
+    pc.a_offset = get_misalign_bytes(ctx, raw) / sizeof(float);
+    pc.b_offset = get_misalign_bytes(ctx, gain) / sizeof(float);
+    memcpy(&pc.eps, norm->op_params, sizeof(pc.eps));
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+        {ggml_vk_tensor_subbuffer(ctx, raw, true), ggml_vk_tensor_subbuffer(ctx, gain, true),
+         vk_subbuffer{ctx->prealloc_y, 0, size}}, pc, {1, 1, 1});
+    ggml_vk_sync_buffers(ctx, subctx);
+    ctx->prealloc_y_last_pipeline_used = ctx->device->pipeline_quantize_q8_1_x4.get();
+    ctx->prealloc_y_last_tensor_used = mul;
+    ctx->prealloc_y_last_decode_vector_staging = false;
+    return true;
