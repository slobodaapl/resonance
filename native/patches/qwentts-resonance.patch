+    const ggml_tensor * mul = graph->nodes[i + 1];
+    const ggml_tensor * raw = norm->src[0];
+    const ggml_tensor * gain = mul->src[0] == norm ? mul->src[1] : mul->src[0];
+    if (raw->type != GGML_TYPE_F32 || gain->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(raw) || !ggml_is_contiguous(gain) || !ggml_is_contiguous(mul) ||
+        ggml_nrows(raw) != 1 || (raw->ne[0] != 1024 && raw->ne[0] != 2048) ||
+        ggml_nelements(gain) != raw->ne[0]) return false;
+    auto supports_mmvq = [ctx, mul](const ggml_tensor * mm) {
+        if (mm->op != GGML_OP_MUL_MAT) return false;
+        const ggml_tensor * weight = mm->src[0];
+        return mm->src[1] == mul &&
+            (weight->type == GGML_TYPE_Q8_0 || weight->type == GGML_TYPE_Q4_K) &&
+            ggml_vk_dim01_contiguous(weight) && weight->ne[2] == 1 && weight->ne[3] == 1 &&
+            ggml_vk_should_use_mmvq(ctx->device, weight->ne[1], 1, weight->ne[0], weight->type) &&
+            ggml_vk_get_dequantize_mul_mat_vec(ctx, weight->type, GGML_TYPE_Q8_1,
+                                             1, mm->ne[0], weight->ne[0]) != nullptr;
+    };
+    if (i + 2 >= graph->n_nodes || !supports_mmvq(graph->nodes[i + 2])) return false;
+    bool matched = false;
+    for (int n_ops : {5, 3}) {
+        const ggml_op ops[] = {GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU};
+        const int output = i + n_ops - 1;
+        if (output >= graph->n_nodes || !ggml_can_fuse_subgraph(graph, i, n_ops, ops, &output, 1)) continue;
+        if (n_ops == 5 && !supports_mmvq(graph->nodes[i + 3])) continue;
