+static void attention_load_qkv(WeightCtx * wctx, const GGUFModel & gf,
+                           const std::string & prefix, TalkerAttention & attn, bool pack) {
+    const char * suffixes[] = {"attn_q.weight", "attn_k.weight", "attn_v.weight"};
+    struct ggml_tensor * src[3];
+    int64_t indices[3];
+    for (int i = 0; i < 3; ++i) {
+        const std::string name = prefix + suffixes[i];
+        indices[i] = gguf_find_tensor(gf.gguf, name.c_str());
+        src[i] = ggml_get_tensor(gf.meta, name.c_str());
+        if (indices[i] < 0 || !src[i]) qt_throw("[GGUF] tensor '%s' not found", name.c_str());
+    }
+    const bool compatible = ggml_n_dims(src[0]) == 2 && ggml_n_dims(src[1]) == 2 && ggml_n_dims(src[2]) == 2 &&
+        src[0]->type == src[1]->type && src[0]->type == src[2]->type &&
+        src[0]->ne[0] == src[1]->ne[0] && src[0]->ne[0] == src[2]->ne[0] &&
+        (src[0]->type == GGML_TYPE_Q8_0 || src[0]->type == GGML_TYPE_Q4_K);
+    if (!pack || !compatible) {
+        attn.q_proj_w = gf_load_tensor(wctx, gf, prefix + suffixes[0]);
+        attn.k_proj_w = gf_load_tensor(wctx, gf, prefix + suffixes[1]);
+        attn.v_proj_w = gf_load_tensor(wctx, gf, prefix + suffixes[2]);
+        return;
+    }
+    struct ggml_tensor * packed = ggml_new_tensor_2d(wctx->ctx, src[0]->type, src[0]->ne[0],
+        src[0]->ne[1] + src[1]->ne[1] + src[2]->ne[1]);
+    attn.qkv_proj_w = packed;
+    ggml_set_name(packed, (prefix + "attn_qkv.weight").c_str());
+    struct ggml_tensor ** views[] = {&attn.q_proj_w, &attn.k_proj_w, &attn.v_proj_w};
+    size_t offset = 0;
+    for (int i = 0; i < 3; ++i) {
+        const size_t size = ggml_nbytes(src[i]);
+        const void * data = gf.mapping + gf.data_offset + gguf_get_tensor_offset(gf.gguf, indices[i]);
+        wctx->pending.push_back({packed, data, size, offset});
+        *views[i] = ggml_view_2d(wctx->ctx, packed, src[i]->ne[0], src[i]->ne[1], packed->nb[1], offset);
+        ggml_set_name(*views[i], (prefix + suffixes[i]).c_str());
+        offset += size;
+    }
+    GGML_ASSERT(offset == ggml_nbytes(packed));
+}
+
+static void attention_load_qk_norm(WeightCtx * wctx, const GGUFModel & gf,
+                               const std::string & prefix, TalkerAttention & attn, bool pack) {
+    struct ggml_tensor * q = ggml_get_tensor(gf.meta, (prefix + "attn_q_norm.weight").c_str());
+    struct ggml_tensor * k = ggml_get_tensor(gf.meta, (prefix + "attn_k_norm.weight").c_str());
+    if (!pack || !attn.qkv_proj_w || !q || !k || q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_F32 ||
+        q->ne[0] <= 0 || q->ne[0] != k->ne[0] || ggml_nelements(q) != q->ne[0] || ggml_nelements(k) != k->ne[0] ||
+        attn.q_proj_w->ne[1] % q->ne[0] != 0 || attn.k_proj_w->ne[1] % q->ne[0] != 0) {
+        attn.q_norm_w = gf_load_tensor(wctx, gf, prefix + "attn_q_norm.weight");
+        attn.k_norm_w = gf_load_tensor(wctx, gf, prefix + "attn_k_norm.weight");
+        return;
+    }
+    const int64_t hd = q->ne[0];
+    const int64_t heads[] = {attn.q_proj_w->ne[1] / hd, attn.k_proj_w->ne[1] / hd};
+    struct ggml_tensor * packed = ggml_new_tensor_2d(wctx->ctx, GGML_TYPE_F32, hd, heads[0] + heads[1]);
+    attn.qk_norm_w = packed;
+    ggml_set_name(packed, (prefix + "attn_qk_norm.weight").c_str());
+    const char * suffixes[] = {"attn_q_norm.weight", "attn_k_norm.weight"};
+    struct ggml_tensor ** views[] = {&attn.q_norm_w, &attn.k_norm_w};
+    size_t offset = 0;
+    for (int i = 0; i < 2; ++i) {
+        const std::string name = prefix + suffixes[i];
+        const int64_t index = gguf_find_tensor(gf.gguf, name.c_str());
+        struct ggml_tensor * src = ggml_get_tensor(gf.meta, name.c_str());
+        GGML_ASSERT(index >= 0 && src && src->type == GGML_TYPE_F32 && ggml_nelements(src) == hd);
+        *views[i] = ggml_view_1d(wctx->ctx, packed, hd, offset);
+        const void * data = gf.mapping + gf.data_offset + gguf_get_tensor_offset(gf.gguf, index);
+        for (int h = 0; h < heads[i]; ++h) {
+            wctx->pending.push_back({packed, data, ggml_nbytes(src), offset});
+            offset += ggml_nbytes(src);
+        }
+    }
+}
 
