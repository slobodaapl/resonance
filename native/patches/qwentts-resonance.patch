+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+
+#include "types.glsl"
+
+layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
+layout(push_constant) uniform parameter {
+    uint ne;
+    uint a_offset;
+    uint b_offset;
+    float eps;
+} p;
+layout(binding = 0) readonly buffer A { float data_a[]; };
+layout(binding = 1) readonly buffer B { float data_b[]; };
+layout(binding = 2) writeonly buffer D { block_q8_1_x4 data_d[]; };
+
+shared float partial[512];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    float sum = 0.0;
+    for (uint col = tid; col < p.ne; col += 512) {
+        const float value = data_a[p.a_offset + col];
+        sum += value * value;
+    }
+    partial[tid] = sum;
+    barrier();
+    [[unroll]] for (uint s = 256; s > 0; s >>= 1) {
+        if (tid < s) {
+            sum += partial[tid + s];
+            partial[tid] = sum;
+        }
+        barrier();
+    }
+    const float scale = inversesqrt(partial[0] / float(p.ne) + p.eps);
+    barrier();
+
+    const bool valid = 4 * tid < p.ne;
+    vec4 values = vec4(0.0);
+    if (valid) {
+        const uint a = p.a_offset + 4 * tid;
+        const uint b = p.b_offset + 4 * tid;
+        values = scale * vec4(data_a[a], data_a[a+1], data_a[a+2], data_a[a+3]) *
+                         vec4(data_b[b], data_b[b+1], data_b[b+2], data_b[b+3]);
+    }
+    const vec4 absolute = abs(values);
+    partial[tid] = max(max(absolute.x, absolute.y), max(absolute.z, absolute.w));
+    barrier();
+    const uint lane = tid % 8;
+    [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
+        if (lane < s) partial[tid] = max(partial[tid], partial[tid + s]);
+        barrier();
+    }
+    const float amax = partial[tid - lane];
+    const float d = amax / 127.0;
+    const float inverse_d = d != 0.0 ? 1.0 / d : 0.0;
+    values = round(values * inverse_d);
+    barrier();
+    partial[tid] = values.x + values.y + values.z + values.w;
+    barrier();
+    [[unroll]] for (uint s = 4; s > 0; s >>= 1) {
+        if (lane < s) partial[tid] += partial[tid + s];
+        barrier();
+    }
+    if (valid) {
+        const uint block = tid / 8;
+        data_d[block / 4].qs[(block % 4) * 8 + lane] = pack32(i8vec4(round(values)));
+        if (lane == 0) data_d[block / 4].ds[block % 4] = f16vec2(vec2(d, partial[tid] * d));
+    }
+}
